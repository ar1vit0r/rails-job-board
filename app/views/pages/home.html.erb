<div class="text-center mb-8">
  <h1 class="text-4xl font-bold text-gray-100 mb-2">Find Your Next Job</h1>
  <p class="text-gray-400">Browse the latest opportunities</p>
</div>

<%= form_with url: jobs_path, method: :get, class: "flex gap-4 mb-8 justify-center" do |f| %>
  <%= f.text_field :q, placeholder: "Search jobs...", class: "bg-gray-800 border border-gray-700 rounded-lg px-4 py-2 w-64 text-gray-100" %>
  <label class="flex items-center gap-2">
    <%= f.check_box :remote, class: "rounded" %>
    <span class="text-gray-400">Remote only</span>
  </label>
  <%= f.submit "Search", class: "bg-cyan-600 text-white px-6 py-2 rounded-lg hover:bg-cyan-700 cursor-pointer" %>
<% end %>

<div class="grid gap-4">
  <% @jobs.each do |job| %>
    <%= link_to job_path(job), class: "block bg-gray-800 border border-gray-700 rounded-lg p-6 hover:border-cyan-500 transition" do %>
      <div class="flex justify-between items-start">
        <div>
          <h2 class="text-lg font-semibold text-gray-100"><%= job.title %></h2>
          <p class="text-gray-400"><%= job.company.name %></p>
          <p class="text-sm text-gray-500 mt-1"><%= job.location %></p>
        </div>
        <div class="text-right">
          <% if job.remote? %>
            <span class="bg-green-900/50 text-green-300 border border-green-700 text-xs px-2 py-1 rounded">Remote</span>
          <% end %>
          <% if job.salary_min.present? && job.salary_max.present? %>
            <p class="text-sm text-gray-400 mt-2">$<%= number_with_delimiter(job.salary_min) %> - $<%= number_with_delimiter(job.salary_max) %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<div class="mt-8 flex gap-2">
  <% if @pagy.page > 1 %>
    <%= link_to "← Previous", root_path(page: @pagy.page - 1), class: "px-4 py-2 bg-gray-800 border border-gray-700 rounded hover:border-cyan-500 text-gray-300" %>
  <% end %>
  <span class="px-4 py-2 text-gray-400">Page <%= @pagy.page %> of <%= @pagy.pages %></span>
  <% if @pagy.page < @pagy.pages %>
    <%= link_to "Next →", root_path(page: @pagy.page + 1), class: "px-4 py-2 bg-gray-800 border border-gray-700 rounded hover:border-cyan-500 text-gray-300" %>
  <% end %>
</div>
