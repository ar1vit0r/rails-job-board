<h1 class="text-2xl font-bold text-gray-900 mb-6">Companies</h1>

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  <% @companies.each do |company| %>
    <%= link_to company_path(company), class: "block bg-white rounded-lg shadow p-6 hover:shadow-md transition" do %>
      <h2 class="text-lg font-semibold text-gray-900"><%= company.name %></h2>
      <p class="text-gray-600 text-sm mt-1"><%= company.description&.truncate(100) %></p>
      <p class="text-indigo-600 text-sm mt-2"><%= company.jobs.count %> open positions</p>
    <% end %>
  <% end %>
</div>
