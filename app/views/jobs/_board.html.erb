<div class="flex flex-wrap items-baseline justify-between gap-x-6 mb-8">
  <h1 class="font-display text-5xl md:text-7xl"><%= title %></h1>
  <p class="text-muted tabular-nums"><%= pluralize(pagy.count, "role") %></p>
</div>

<%= form_with url: jobs_path, method: :get, class: "flex flex-wrap items-center gap-x-4 gap-y-3 mb-10" do |f| %>
  <%= f.search_field :q, value: params[:q], placeholder: "Job title or keyword", "aria-label": "Search jobs", class: "field sm:max-w-sm" %>
  <label class="flex items-center gap-2 text-muted">
    <%= f.check_box :remote, checked: params[:remote] == "1", class: "size-4 accent-signal" %>
    Remote only
  </label>
  <%= f.submit "Search", class: "btn" %>
<% end %>

<% if jobs.any? %>
  <div class="board-cols hidden md:grid gap-x-6 -mx-3 px-3 pb-2 text-sm text-muted border-b border-paper/40">
    <span>Posted</span>
    <span>Role</span>
    <span>Company</span>
    <span>Location</span>
    <span class="text-right">Pay</span>
  </div>
  <%= render partial: "jobs/job", collection: jobs %>
<% else %>
  <p class="text-muted py-10">No jobs match. Clear the search or turn off Remote only.</p>
<% end %>

<% if pagy.pages > 1 %>
  <nav class="mt-8 flex items-center gap-6 text-muted" aria-label="Pagination">
    <% if pagy.page > 1 %>
      <%= link_to "Previous", url_for(request.query_parameters.merge(page: pagy.page - 1)), class: "text-paper underline decoration-signal underline-offset-4" %>
    <% end %>
    <span class="tabular-nums">Page <%= pagy.page %> of <%= pagy.pages %></span>
    <% if pagy.page < pagy.pages %>
      <%= link_to "Next", url_for(request.query_parameters.merge(page: pagy.page + 1)), class: "text-paper underline decoration-signal underline-offset-4" %>
    <% end %>
  </nav>
<% end %>
