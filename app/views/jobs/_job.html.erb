<%= link_to job_path(job), style: "--i: #{job_counter}", class: "board-row board-cols group grid gap-x-6 gap-y-1 -mx-3 px-3 py-4 border-b border-rule md:items-baseline hover:bg-row focus-visible:bg-row" do %>
  <p class="text-sm tabular-nums md:text-base <%= job.created_at > 3.days.ago ? "text-signal" : "text-muted" %>"><%= job_age(job.created_at) %></p>
  <h2 class="text-lg font-semibold group-hover:underline decoration-signal underline-offset-4"><%= job.title %></h2>
  <p class="text-muted md:text-paper"><%= job.company.name %></p>
  <p class="text-muted">
    <%= job.location %>
    <% if job.remote? %>
      <span class="ml-1 bg-signal text-board text-xs font-bold px-1.5 py-0.5 rounded-sm">Remote</span>
    <% end %>
  </p>
  <p class="text-muted tabular-nums md:text-right">
    <% if job.salary_min.present? && job.salary_max.present? %>
      $<%= number_with_delimiter(job.salary_min) %> – $<%= number_with_delimiter(job.salary_max) %>
    <% end %>
  </p>
<% end %>
