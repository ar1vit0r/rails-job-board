<%= link_to "← Back to jobs", jobs_path, class: "text-indigo-600 hover:underline mb-4 inline-block" %>

<div class="bg-white rounded-lg shadow p-8">
  <div class="flex justify-between items-start mb-6">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= @job.title %></h1>
      <p class="text-xl text-gray-600"><%= link_to @job.company.name, company_path(@job.company), class: "hover:text-indigo-600" %></p>
    </div>
    <div class="text-right">
      <% if @job.remote? %>
        <span class="bg-green-100 text-green-800 text-sm px-3 py-1 rounded">Remote</span>
      <% end %>
      <% if @job.salary_min.present? && @job.salary_max.present? %>
        <p class="text-lg text-gray-700 mt-2">$<%= number_with_delimiter(@job.salary_min) %> - $<%= number_with_delimiter(@job.salary_max) %></p>
      <% end %>
    </div>
  </div>

  <p class="text-gray-500 mb-4"><%= @job.location %></p>
  <div class="prose max-w-none mb-8">
    <%= simple_format @job.description %>
  </div>
</div>

<div class="bg-white rounded-lg shadow p-8 mt-6">
  <h2 class="text-xl font-bold text-gray-900 mb-4">Apply for this position</h2>

  <% if @job_application.errors.any? %>
    <div class="bg-red-50 text-red-800 px-4 py-2 rounded mb-4">
      <% @job_application.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @job_application, url: job_job_applications_path(@job), class: "space-y-4" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
    <div>
      <%= f.label :message, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :message, rows: 4, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
    <%= f.submit "Submit Application", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer" %>
  <% end %>
</div>
