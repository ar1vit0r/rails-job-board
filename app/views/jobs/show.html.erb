<%= link_to "Back to jobs", jobs_path, class: "text-muted hover:text-paper underline decoration-signal underline-offset-4" %>

<header class="mt-6 pb-8 border-b border-paper/40 flex flex-wrap justify-between items-end gap-x-8 gap-y-4">
  <div>
    <h1 class="font-display text-5xl md:text-7xl"><%= @job.title %></h1>
    <p class="text-xl mt-3"><%= link_to @job.company.name, company_path(@job.company), class: "underline decoration-signal underline-offset-4" %></p>
    <p class="text-muted mt-1">
      <%= @job.location %>
      <% if @job.remote? %>
        <span class="ml-1 bg-signal text-board text-xs font-bold px-1.5 py-0.5 rounded-sm">Remote</span>
      <% end %>
    </p>
  </div>
  <% if @job.salary_min.present? && @job.salary_max.present? %>
    <p class="text-2xl font-semibold tabular-nums">$<%= number_with_delimiter(@job.salary_min) %> – $<%= number_with_delimiter(@job.salary_max) %></p>
  <% end %>
</header>

<div class="mt-10 grid gap-12 lg:grid-cols-[minmax(0,1fr)_22rem] items-start">
  <div class="font-serif text-lg leading-8 max-w-[65ch] space-y-4">
    <%= simple_format @job.description %>
  </div>

  <section class="lg:sticky lg:top-6 border-t-4 border-signal bg-row p-6">
    <h2 class="text-xl font-bold mb-4">Apply for this position</h2>

    <% if @job_application.errors.any? %>
      <div class="border-l-4 border-red-400 text-red-200 px-3 py-2 mb-4">
        <% @job_application.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= form_with model: @job_application, url: job_job_applications_path(@job), class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, class: "block text-sm text-muted mb-1" %>
        <%= f.text_field :name, class: "field" %>
      </div>
      <div>
        <%= f.label :email, class: "block text-sm text-muted mb-1" %>
        <%= f.email_field :email, class: "field" %>
      </div>
      <div>
        <%= f.label :message, class: "block text-sm text-muted mb-1" %>
        <%= f.text_area :message, rows: 4, class: "field" %>
      </div>
      <%= f.submit "Submit Application", class: "btn" %>
    <% end %>
  </section>
</div>
