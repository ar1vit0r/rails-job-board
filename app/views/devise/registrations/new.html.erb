<div class="max-w-md mx-auto">
  <h2 class="font-display text-4xl md:text-5xl mb-6">Sign up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm text-muted mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm text-muted mb-1" %>
      <% if @minimum_password_length %>
        <span class="text-xs text-muted">(<%= @minimum_password_length %> characters minimum)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "field" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm text-muted mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field" %>
    </div>

    <%= f.submit "Sign up", class: "btn w-full" %>
  <% end %>

  <div class="mt-4 text-sm text-muted">
    <%= link_to "Log in", new_session_path(resource_name), class: "text-signal hover:underline" %>
  </div>
</div>
