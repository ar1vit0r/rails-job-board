<%# The yellow fill sits on the <td bgcolor>, not on the link: Outlook desktop ignores background and padding on inline links. %>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">
  <tr>
    <td bgcolor="<%= mail_color(:signal) %>" style="background:<%= mail_color(:signal) %>; border-radius:4px;">
      <%= link_to text, url, style: "display:inline-block; padding:10px 20px; color:#{mail_color(:board)}; font-weight:700; text-decoration:none;" %>
    </td>
  </tr>
</table>
