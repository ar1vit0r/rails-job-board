<p>Hello <%= @resource.email %>!</p>

<p>Someone has requested a link to change your password. You can do this through the link below.</p>

<%= render "devise/mailer/button", text: "Change my password", url: edit_password_url(@resource, reset_password_token: @token) %>

<p style="color:<%= mail_color(:muted) %>;">If you didn't request this, please ignore this email.</p>
<p style="color:<%= mail_color(:muted) %>;">Your password won't change until you access the link above and create a new one.</p>
