<div class="max-w-md mx-auto">
  <h2 class="font-display text-4xl md:text-5xl mb-6">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm text-muted mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm text-muted mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "field" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "size-4 accent-signal" %>
        <%= f.label :remember_me, class: "text-sm text-muted" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "btn w-full" %>
  <% end %>

  <div class="mt-4 text-sm text-muted space-y-1">
    <%= link_to "Sign up", new_registration_path(resource_name), class: "text-signal hover:underline" %>
    <br>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-signal hover:underline" %>
  </div>
</div>
