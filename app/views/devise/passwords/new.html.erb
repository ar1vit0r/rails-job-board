<div class="max-w-md mx-auto">
  <h2 class="font-display text-4xl md:text-5xl mb-6">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm text-muted mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field" %>
    </div>

    <%= f.submit "Send reset instructions", class: "btn w-full" %>
  <% end %>

  <div class="mt-4 text-sm text-muted">
    <%= link_to "Back to log in", new_session_path(resource_name), class: "text-signal hover:underline" %>
  </div>
</div>
