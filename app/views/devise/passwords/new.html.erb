<div class="max-w-md mx-auto">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border rounded-lg px-4 py-2 w-full" %>
    </div>

    <%= f.submit "Send reset instructions", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer w-full" %>
  <% end %>

  <div class="mt-4 text-sm text-gray-600">
    <%= link_to "Back to log in", new_session_path(resource_name), class: "text-indigo-600 hover:underline" %>
  </div>
</div>
