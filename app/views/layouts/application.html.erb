<!DOCTYPE html>
<html>
  <head>
    <title>Rails Job Board</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Source+Serif+4:opsz,wght@8..60,400..700&display=swap">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="border-b border-rule">
      <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-x-6 gap-y-2">
        <%= link_to "Job Board", root_path, class: "font-display text-3xl text-signal" %>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-muted">
          <%= link_to "Jobs", jobs_path, class: "hover:text-paper" %>
          <%= link_to "Companies", companies_path, class: "hover:text-paper" %>
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_dashboard_path, class: "hover:text-paper" %>
            <% end %>
            <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "hover:text-paper cursor-pointer" %>
          <% else %>
            <%= link_to "Login", new_user_session_path, class: "hover:text-paper" %>
            <%= link_to "Sign up", new_user_registration_path, class: "btn" %>
          <% end %>
        </div>
      </div>
    </nav>
    <main class="max-w-6xl mx-auto px-4 py-10">
      <% if notice %>
        <p class="border-l-4 border-signal bg-row px-4 py-2 mb-6"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="border-l-4 border-red-400 bg-row text-red-200 px-4 py-2 mb-6"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
