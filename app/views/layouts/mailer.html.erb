<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="color-scheme" content="dark">
    <style>
      /* Email styles need to be inline; this block is only a progressive enhancement */
      p { margin: 0 0 16px; line-height: 1.5; }
    </style>
  </head>

  <body style="margin:0; padding:0; background:#0e2a26;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#0e2a26;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="width:100%; max-width:560px;">
            <tr>
              <td style="padding-bottom:16px; border-bottom:1px solid #2a5a52; font-family:'Archivo Narrow','Arial Narrow',Arial,sans-serif; font-size:28px; font-weight:800; letter-spacing:0.01em; color:#ffc72c;">
                Job Board
              </td>
            </tr>
            <tr>
              <td style="padding-top:24px; font-family:Archivo,'Helvetica Neue',Arial,sans-serif; font-size:16px; color:#f1ede2;">
                <%= yield %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
