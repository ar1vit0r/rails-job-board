<%= form_with model: [:admin, company], class: "space-y-4" do |f| %>
  <% if company.errors.any? %>
    <div class="border-l-4 border-red-400 text-red-200 px-3 py-2">
      <% company.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm text-muted mb-1" %>
    <%= f.text_field :name, class: "field" %>
  </div>
  <div>
    <%= f.label :website, class: "block text-sm text-muted mb-1" %>
    <%= f.url_field :website, class: "field" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm text-muted mb-1" %>
    <%= f.text_area :description, rows: 4, class: "field" %>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "btn" %>
    <%= link_to "Cancel", admin_companies_path, class: "border border-rule px-5 py-2 rounded text-muted hover:bg-row hover:text-paper" %>
  </div>
<% end %>
