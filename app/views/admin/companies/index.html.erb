<div class="flex justify-between items-center mb-6">
  <h1 class="font-display text-4xl md:text-5xl">Companies</h1>
  <%= link_to "New Company", new_admin_company_path, class: "btn" %>
</div>

<div class="overflow-hidden border border-rule">
  <table class="w-full">
    <thead class="border-b border-paper/40">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Name</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Website</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Jobs</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-rule">
      <% @companies.each do |company| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium"><%= company.name %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= company.website %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= company.jobs.count %></td>
          <td class="px-6 py-4 text-sm space-x-2">
            <%= link_to "Edit", edit_admin_company_path(company), class: "text-signal hover:underline" %>
            <%= button_to "Delete", admin_company_path(company), method: :delete, class: "text-red-300 hover:underline", data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
