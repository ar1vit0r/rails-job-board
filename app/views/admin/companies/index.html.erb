<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Companies</h1>
  <%= link_to "New Company", new_admin_company_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700" %>
</div>

<div class="bg-white rounded-lg shadow overflow-hidden">
  <table class="w-full">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Name</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Website</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Jobs</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @companies.each do |company| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= company.name %></td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= company.website %></td>
          <td class="px-6 py-4 text-sm text-gray-600"><%= company.jobs.count %></td>
          <td class="px-6 py-4 text-sm space-x-2">
            <%= link_to "Edit", edit_admin_company_path(company), class: "text-indigo-600 hover:underline" %>
            <%= button_to "Delete", admin_company_path(company), method: :delete, class: "text-red-600 hover:underline", data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
