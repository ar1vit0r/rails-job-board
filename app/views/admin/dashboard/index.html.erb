<h1 class="font-display text-4xl md:text-5xl mb-6">Admin Dashboard</h1>

<div class="grid gap-6 md:grid-cols-3 mb-8">
  <%= link_to admin_companies_path, class: "bg-row p-6 border-t-4 border-signal hover:bg-rule/40" do %>
    <h2 class="text-lg font-semibold">Companies</h2>
    <p class="text-3xl font-bold text-signal tabular-nums"><%= @companies.count %></p>
  <% end %>
  <%= link_to admin_jobs_path, class: "bg-row p-6 border-t-4 border-signal hover:bg-rule/40" do %>
    <h2 class="text-lg font-semibold">Jobs</h2>
    <p class="text-3xl font-bold text-signal tabular-nums"><%= @jobs.count %></p>
  <% end %>
  <div class="bg-row p-6 border-t-4 border-signal">
    <h2 class="text-lg font-semibold">Applications</h2>
    <p class="text-3xl font-bold text-signal tabular-nums"><%= @applications.count %></p>
  </div>
</div>

<h2 class="text-2xl font-bold mb-4">Recent Applications</h2>
<div class="overflow-hidden border border-rule">
  <table class="w-full">
    <thead class="border-b border-paper/40">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Name</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Email</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Job</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Date</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-rule">
      <% @applications.order(created_at: :desc).limit(10).each do |app| %>
        <tr>
          <td class="px-6 py-4 text-sm text-paper"><%= app.name %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= app.email %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= app.job.title %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= app.created_at.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
