<%= form_with model: [:admin, job], class: "space-y-4" do |f| %>
  <% if job.errors.any? %>
    <div class="bg-red-50 text-red-800 px-4 py-2 rounded">
      <% job.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div>
    <%= f.label :company_id, class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :company_id, Company.all, :id, :name, { prompt: "Select company" }, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 6, class: "border rounded-lg px-4 py-2 w-full" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :location, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :location, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
    <div class="flex items-center gap-2 pt-6">
      <%= f.check_box :remote, class: "rounded" %>
      <%= f.label :remote, "Remote position", class: "text-sm text-gray-700" %>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :salary_min, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :salary_min, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
    <div>
      <%= f.label :salary_max, class: "block text-sm font-medium text-gray-700" %>
      <%= f.number_field :salary_max, class: "border rounded-lg px-4 py-2 w-full" %>
    </div>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_jobs_path, class: "bg-gray-200 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-300" %>
  </div>
<% end %>
