<%= form_with model: [:admin, job], class: "space-y-4" do |f| %>
  <% if job.errors.any? %>
    <div class="border-l-4 border-red-400 text-red-200 px-3 py-2">
      <% job.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm text-muted mb-1" %>
    <%= f.text_field :title, class: "field" %>
  </div>
  <div>
    <%= f.label :company_id, class: "block text-sm text-muted mb-1" %>
    <%= f.collection_select :company_id, Company.all, :id, :name, { prompt: "Select company" }, class: "field" %>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm text-muted mb-1" %>
    <%= f.text_area :description, rows: 6, class: "field" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :location, class: "block text-sm text-muted mb-1" %>
      <%= f.text_field :location, class: "field" %>
    </div>
    <div class="flex items-center gap-2 pt-6">
      <%= f.check_box :remote, class: "size-4 accent-signal" %>
      <%= f.label :remote, "Remote position", class: "text-sm text-muted" %>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :salary_min, class: "block text-sm text-muted mb-1" %>
      <%= f.number_field :salary_min, class: "field" %>
    </div>
    <div>
      <%= f.label :salary_max, class: "block text-sm text-muted mb-1" %>
      <%= f.number_field :salary_max, class: "field" %>
    </div>
  </div>
  <div class="flex gap-2">
    <%= f.submit class: "btn" %>
    <%= link_to "Cancel", admin_jobs_path, class: "border border-rule px-5 py-2 rounded text-muted hover:bg-row hover:text-paper" %>
  </div>
<% end %>
