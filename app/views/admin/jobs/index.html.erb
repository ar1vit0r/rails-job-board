<div class="flex justify-between items-center mb-6">
  <h1 class="font-display text-4xl md:text-5xl">Jobs</h1>
  <%= link_to "New Job", new_admin_job_path, class: "btn" %>
</div>

<div class="overflow-hidden border border-rule">
  <table class="w-full">
    <thead class="border-b border-paper/40">
      <tr>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Title</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Company</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Location</th>
        <th class="px-6 py-3 text-left text-sm font-medium text-muted">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-rule">
      <% @jobs.each do |job| %>
        <tr>
          <td class="px-6 py-4 text-sm font-medium"><%= job.title %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= job.company.name %></td>
          <td class="px-6 py-4 text-sm text-muted"><%= job.location %></td>
          <td class="px-6 py-4 text-sm space-x-2">
            <%= link_to "Edit", edit_admin_job_path(job), class: "text-signal hover:underline" %>
            <%= button_to "Delete", admin_job_path(job), method: :delete, class: "text-red-300 hover:underline", data: { turbo_confirm: "Are you sure?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
